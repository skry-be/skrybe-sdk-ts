{
  "name": "@skrybe/sdk",
  "version": "2.0.0",
  "description": "Official TypeScript/JavaScript SDK for the Skrybe email marketing API",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "node --import tsx --test test/*.test.ts",
    "prepublishOnly": "npm run build",
    "release:prepare": "node scripts/release.mjs prepare"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsup": "^8.3.5",
    "tsx": "^4.23.13",
    "typescript": "^5.6.3"
  },
  "keywords": [
    "skrybe",
    "email",
    "marketing",
    "api",
    "sdk"
  ],
  "author": "Skrybe",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skry-be/skrybe-sdk-ts.git",
    "directory": "typescript"
  },
  "homepage": "https://github.com/skry-be/skrybe-sdk-ts/tree/main/typescript#readme",
  "bugs": {
    "url": "https://github.com/skry-be/skrybe-sdk-ts/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
